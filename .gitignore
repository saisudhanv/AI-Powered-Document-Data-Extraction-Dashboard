# ========================
# Root .gitignore
# ========================

# --- OS Generated ---
.DS_Store
Thumbs.db
Desktop.ini

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# ========================
# Backend (Python/FastAPI)
# ========================

# Environment variables (contains API keys!)
backend/.env

# Python virtual environment
backend/venv/

# Byte-compiled / optimized files
backend/__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
*.pyo

# SQLite database (generated at runtime)
backend/documents.db

# Uploaded files (user uploads, generated at runtime)
backend/uploads/

# Distribution / packaging
*.egg-info/
dist/
build/

# ========================
# Frontend (Next.js)
# ========================

# Dependencies
frontend/node_modules/

# Next.js build output
frontend/.next/
frontend/out/

# Production build
frontend/build/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment variables
frontend/.env*

# Vercel
frontend/.vercel/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Misc
*.pem
/coverage/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
